_pkgname=virtual-ac3-encoder-linux
pkgname=pipewire-module-virtual-ac3-encoder-git
pkgver=0.1.0.alpha2.r0.g0000000
pkgrel=1
pkgdesc='Low-latency PipeWire virtual 5.1 sink with Dolby Digital AC-3 / IEC 61937 output'
arch=('x86_64' 'aarch64')
url='https://github.com/estacia/virtual-ac3-encoder_linux'
license=('MIT')
depends=('pipewire')
makedepends=('git' 'meson' 'ninja' 'pkgconf' 'ffmpeg')
provides=('pipewire-module-virtual-ac3-encoder')
conflicts=('pipewire-module-virtual-ac3-encoder')
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${_pkgname}"
  local described
  described="$(git describe --tags --long 2>/dev/null || true)"
  if [[ -n "${described}" ]]; then
    printf '%s' "${described#v}" | sed 's/-/./g'
  else
    printf '0.1.0.alpha2.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

build() {
  meson setup --prefix=/usr build "${srcdir}/${_pkgname}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "${pkgdir}"
  install -Dm644 "${srcdir}/${_pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/${_pkgname}/NOTICE.md" "${pkgdir}/usr/share/doc/${pkgname}/NOTICE.md"
}
